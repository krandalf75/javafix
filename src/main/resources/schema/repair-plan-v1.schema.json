{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://javafix.github.io/schemas/repair-plan-v1.schema.json",
  "title": "JavaFix repair plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repairs"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "repairs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "parameters": { "type": "object", "maxProperties": 0 }
            }
          }
        ]
      }
    }
  }
}
